# Copy to .env (never commit .env) or export these in your shell.
GEMINI_API_KEY=your-key-here
# Optional: override the model alias used for all Gemini calls
# GEMINI_MODEL=gemini-flash-latest
# Optional pacing/retry tuning (free tiers rate-limit bursts; set interval to 0 on a paid tier)
# GEMINI_MIN_INTERVAL_S=5
# GEMINI_MAX_RETRIES=3
